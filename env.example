# ============================================================
#  YTA TOOLS — Environment Variables
#  Sa Netlify: i-add ito sa Site Settings > Environment Variables
# ============================================================

# --- Anthropic API (para sa AI Generators) ---
# Kumuha sa: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxx

# --- Google OAuth (para sa YouTube Login) ---
# Kumuha sa: https://console.cloud.google.com
# 1. New Project > APIs & Services > Enable:
#    - YouTube Data API v3
#    - YouTube Analytics API
# 2. Credentials > Create OAuth 2.0 Client ID
# 3. Application type: Web application
# 4. Authorized redirect URIs:
#    https://YOUR-SITE.netlify.app/auth/callback
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://YOUR-SITE.netlify.app/auth/callback

# --- Netlify auto-sets this (huwag baguhin) ---
# URL=https://YOUR-SITE.netlify.app
